# Production: set through the hosting secret settings. Never commit real credentials.
SPRING_PROFILES_ACTIVE=prod,google
DB_URL=jdbc:postgresql://db.example.invalid:5432/stelody?sslmode=verify-full
DB_USERNAME=stelody_app
# Actual PostgreSQL role (pooler login names can include a project suffix).
DB_RUNTIME_ROLE=stelody_app
DB_PASSWORD=replace-me
DB_MIGRATION_USERNAME=stelody_migrator
DB_MIGRATION_PASSWORD=replace-me

# Enable the google profile only after configuring the OAuth web client.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://stelody.example.invalid/api/v1/auth/callback/google

# Positive per-account saved-song limit; unavailable favorites also count.
FAVORITE_LIMIT=5000

# Positive per-account playlist limit and per-playlist saved-song limit.
PLAYLIST_LIMIT=50
PLAYLIST_ITEM_LIMIT=500
