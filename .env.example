# Production: set through the hosting secret settings. Never commit real credentials.
SPRING_PROFILES_ACTIVE=prod,google
DB_URL=jdbc:postgresql://db.example.invalid:5432/stelody?sslmode=verify-full
DB_USERNAME=stelody_app
# Actual PostgreSQL role (pooler login names can include a project suffix).
DB_RUNTIME_ROLE=stelody_app
DB_PASSWORD=replace-me
DB_MIGRATION_USERNAME=stelody_migrator
DB_MIGRATION_PASSWORD=replace-me

# Enable the google profile only after configuring the OAuth web client.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://stelody.example.invalid/api/v1/auth/callback/google

# Positive per-account saved-song limit; unavailable favorites also count.
FAVORITE_LIMIT=5000

# Positive per-account playlist limit and per-playlist saved-song limit.
PLAYLIST_LIMIT=50
PLAYLIST_ITEM_LIMIT=500

# Independent, non-web collector. Keep disabled until V8, least-privilege role and API key are ready.
COLLECTOR_ENABLED=false
COLLECTOR_DB_URL=jdbc:postgresql://db.example.invalid:5432/stelody?sslmode=verify-full
COLLECTOR_DB_USERNAME=stelody_collector
COLLECTOR_DB_PASSWORD=replace-me
YOUTUBE_API_KEY=replace-me
# --discover additionally requires this explicit opt-in. Classification remains disabled until policy confirmation.
DISCOVERY_ENABLED=false
DISCOVERY_CLASSIFICATION_ALLOWED=false
# Auto publication also requires the persisted administrator control (default false).
COVER_AUTO_PUBLICATION_POLICY_ALLOWED=false

# Derived ranking is unavailable unless both flags are true after policy confirmation.
TRENDING_ENABLED=false
TRENDING_POLICY_ALLOWED=false

# One-shot --admin-account command only. Apply V11 and provision a separate operator role first.
# Do not use these credentials for the web server or collector.
ADMIN_DB_URL=jdbc:postgresql://db.example.invalid:5432/stelody?sslmode=verify-full
ADMIN_DB_USERNAME=stelody_operator
ADMIN_DB_PASSWORD=replace-me

# YouTube export: same Google web client; tokens are encrypted with a separate 32-byte key
YOUTUBE_EXPORT_ENABLED=false
YOUTUBE_EXPORT_REDIRECT_URI=http://localhost:8080/api/v1/me/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Web queues retries; separately enabled collector consumes them on its next invocation.
COLLECTION_RETRY_ENABLED=false

# Anniversary review suggestions: keep disabled until derived-metadata policy confirmation.
SPECIAL_EVENT_REVIEW_ENABLED=false
SPECIAL_EVENT_POLICY_ALLOWED=false
