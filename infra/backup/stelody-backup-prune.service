[Unit]
Description=Expire Stelody backups

[Service]
Type=oneshot
User=stelody-backup
Group=stelody-backup
UMask=0077
ExecStart=/usr/bin/python3 /opt/stelody/infra/backup/database.py prune --directory=/var/lib/stelody-backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stelody-backups
